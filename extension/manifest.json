{
  "manifest_version": 3,
  "name": "Türkçe LLM DLP",
  "version": "1.1.0",
  "description": "ChatGPT ve Claude'a giden mesajlardaki kişisel verileri yerel DLP servisiyle bulur, yer tutucuyla değiştirir ve yanıtta geri yerleştirir.",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "extract.js",
        "guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
